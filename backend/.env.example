# --- Shared ---
# Product name: app display name, admin web title, invoice description (API, admin web and app read it)
APP_NAME=Open Cinema

# --- API (backend) ---
# Interface to bind. Leave unset: 127.0.0.1 in production (behind the reverse proxy), all interfaces (Node default) otherwise.
HOST=
# HTTP port
PORT=8080
# node environment: development | test | production
NODE_ENV=development
# Postgres connection for local development
DATABASE_URL=postgresql://localhost:5432/open_cinema_dev
# Database TLS: off | require (encrypted, server identity NOT checked) | verify (checked against
# DATABASE_CA_FILE, else the system store). Default: require in production (warns), off otherwise.
# Recommended in production: verify with your database provider's CA. sslmode=verify-full in the URL is honoured.
DATABASE_SSL=
# PEM file of the database's certificate authority (for DATABASE_SSL=verify)
DATABASE_CA_FILE=
# Postgres connection used by the test suite
TEST_DATABASE_URL=postgresql://localhost:5432/open_cinema_test
# HMAC secret for access tokens (use a long random string)
JWT_SECRET=change-me-jwt
# HMAC secret for ticket QR tokens
QR_SECRET=change-me-qr
# HMAC secret for public ticket links and pass URLs
LINK_SECRET=change-me-link
# Public base URL of the API
API_PUBLIC_URL=http://localhost:8080
# Public base URL of the admin web app
WEB_PUBLIC_URL=http://localhost:3000
# Secret shared by the API and the admin web app (32+ chars, required in production; set the same
# value in the admin web's environment). A request carrying it in x-oc-bff-secret is rate limited by the end
# user's x-oc-client-ip instead of the web server's address. Leave empty for local development.
BFF_SECRET=
# Reverse-proxy hops in front of the API for direct app traffic (0 = none). Sets Express "trust proxy".
TRUST_PROXY=0
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000
# Message delivery: dev (logs codes; default) | wesend (optional adapter)
MESSAGES_PROVIDER=dev
# API key (only when MESSAGES_PROVIDER=wesend)
WESEND_API_KEY=
# Sender display name for email (wesend only)
WESEND_FROM_NAME=Open Cinema
# Reply-to address for email (optional)
WESEND_REPLY_TO=
# File storage: local (files under backend/uploads, default) | supabase (optional adapter)
STORAGE_PROVIDER=local
# Project URL (only when STORAGE_PROVIDER=supabase)
SUPABASE_URL=
# Service role key (server only)
SUPABASE_SERVICE_ROLE_KEY=
# Public storage bucket name
SUPABASE_BUCKET=
# Payment provider: mock
PAYMENT_PROVIDER=mock
# Production refuses the mock provider (any customer could mark an order paid) unless this is 1
ALLOW_MOCK_PAYMENTS=
# Apple Wallet pass type identifier, e.g. pass.com.example.opencinema (optional; Wallet is disabled when unset)
WALLET_PASS_TYPE_ID=
# Apple developer team id for Wallet passes
WALLET_TEAM_ID=
# Organization name shown on Wallet passes
WALLET_ORG_NAME=Open Cinema
# Path to the Wallet signer certificate (.pem)
WALLET_SIGNER_CERT_PATH=
# Path to the Wallet signer private key (.pem)
WALLET_SIGNER_KEY_PATH=
# Passphrase of the signer key, if any
WALLET_SIGNER_KEY_PASSPHRASE=
# Path to the Apple WWDR certificate (.pem)
WALLET_WWDR_PATH=
# Demo admin created by `db:seed` (development only; the seed refuses NODE_ENV=production).
# In production create the first admin with `admin:create:prod` (see docs/deploy.md).
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-admin
