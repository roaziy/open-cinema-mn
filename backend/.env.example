# Open Cinema API. Copy to .env and fill in. Details: docs/credentials.md

# ===== Server =====
# Product name (invoices, emails)
APP_NAME=Open Cinema
# Interface to bind; unset = 127.0.0.1 in production, all interfaces otherwise
HOST=
PORT=8080
# development | test | production
NODE_ENV=development
# Public URL of this API and of the admin web
API_PUBLIC_URL=http://localhost:8080
WEB_PUBLIC_URL=http://localhost:3000
# Comma-separated origins allowed by CORS
CORS_ORIGINS=http://localhost:3000
# Reverse-proxy hops in front of the API (0 = none)
TRUST_PROXY=0

# ===== Database =====
DATABASE_URL=postgresql://localhost:5432/open_cinema_dev
# Used by `npm test` (its tables are wiped)
TEST_DATABASE_URL=postgresql://localhost:5432/open_cinema_test
# off | require | verify (default: require in production, off otherwise)
DATABASE_SSL=
# CA certificate (.pem) for DATABASE_SSL=verify
DATABASE_CA_FILE=

# ===== Secrets (long random strings; required in production) =====
JWT_SECRET=change-me-jwt
QR_SECRET=change-me-qr
LINK_SECRET=change-me-link
# Same value as BFF_SECRET in web-admin/.env (32+ chars in production; empty locally)
BFF_SECRET=

# ===== Demo data (development only, used by `npm run db:seed`) =====
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-admin

# ===== Login codes (phone and email sign-in) =====
# dev: not sent, printed in the backend terminal (development only; production hides them)
# wesend: real SMS and email through wesend.mn (needs WESEND_API_KEY)
MESSAGES_PROVIDER=dev
# wesend only: API key, sender name on emails, optional reply-to address
WESEND_API_KEY=
WESEND_FROM_NAME=Open Cinema
WESEND_REPLY_TO=

# ===== File storage (posters and images uploaded in the admin) =====
# local: saved in backend/uploads and served by the API at /media (back the folder up)
# r2: saved in a Cloudflare R2 bucket (free tier: 10 GB)
STORAGE_PROVIDER=local
# r2 only, from the R2 dashboard: Account ID, bucket name, an API token's access key ID and
# secret (Object Read & Write), and the bucket's public URL (r2.dev or a custom domain)
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=

# ===== Films from TMDB (optional; only for `npm run movies:update`) =====
# Free "API Read Access Token" from themoviedb.org (Settings -> API). Sent as a Bearer header.
# TMDB's terms require crediting them where the data is shown; the README carries the notice.
TMDB_READ_TOKEN=
# Country whose cinema releases are imported (2-letter code, e.g. US, GB, KR)
TMDB_REGION=US

# ===== Payments: mock (production refuses it unless ALLOW_MOCK_PAYMENTS=1) =====
PAYMENT_PROVIDER=mock
ALLOW_MOCK_PAYMENTS=

# ===== Apple Wallet (optional; off while WALLET_PASS_TYPE_ID is empty) =====
WALLET_PASS_TYPE_ID=
WALLET_TEAM_ID=
WALLET_ORG_NAME=Open Cinema
# Paths to the signer certificate, its key and Apple's WWDR certificate (.pem)
WALLET_SIGNER_CERT_PATH=
WALLET_SIGNER_KEY_PATH=
WALLET_SIGNER_KEY_PASSPHRASE=
WALLET_WWDR_PATH=
