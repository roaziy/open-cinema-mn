# Open Cinema API. Copy to .env and fill in. Details: docs/credentials.md

# ===== Server =====
# Product name (invoices, emails)
APP_NAME=Open Cinema
# Interface to bind; unset = 127.0.0.1 in production, all interfaces otherwise
HOST=
PORT=8080
# development | test | production
NODE_ENV=development
# Public URL of this API and of the admin web
API_PUBLIC_URL=http://localhost:8080
WEB_PUBLIC_URL=http://localhost:3000
# Comma-separated origins allowed by CORS
CORS_ORIGINS=http://localhost:3000
# Reverse-proxy hops in front of the API (0 = none)
TRUST_PROXY=0

# ===== Database =====
DATABASE_URL=postgresql://localhost:5432/open_cinema_dev
# Used by `npm test` (its tables are wiped)
TEST_DATABASE_URL=postgresql://localhost:5432/open_cinema_test
# off | require | verify (default: require in production, off otherwise)
DATABASE_SSL=
# CA certificate (.pem) for DATABASE_SSL=verify
DATABASE_CA_FILE=

# ===== Secrets (long random strings; required in production) =====
JWT_SECRET=change-me-jwt
QR_SECRET=change-me-qr
LINK_SECRET=change-me-link
# Same value as BFF_SECRET in web-admin/.env (32+ chars in production; empty locally)
BFF_SECRET=

# ===== Demo data (development only, used by `npm run db:seed`) =====
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-admin

# ===== Login codes: dev (printed in the log) | wesend =====
MESSAGES_PROVIDER=dev
WESEND_API_KEY=
WESEND_FROM_NAME=Open Cinema
WESEND_REPLY_TO=

# ===== File storage: local (backend/uploads) | supabase =====
STORAGE_PROVIDER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=

# ===== Payments: mock (production refuses it unless ALLOW_MOCK_PAYMENTS=1) =====
PAYMENT_PROVIDER=mock
ALLOW_MOCK_PAYMENTS=

# ===== Apple Wallet (optional; off while WALLET_PASS_TYPE_ID is empty) =====
WALLET_PASS_TYPE_ID=
WALLET_TEAM_ID=
WALLET_ORG_NAME=Open Cinema
# Paths to the signer certificate, its key and Apple's WWDR certificate (.pem)
WALLET_SIGNER_CERT_PATH=
WALLET_SIGNER_KEY_PATH=
WALLET_SIGNER_KEY_PASSPHRASE=
WALLET_WWDR_PATH=
