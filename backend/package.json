{
  "name": "@open-cinema/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --import tsx --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:migrate:prod": "node --env-file-if-exists=.env dist/migrate.js",
    "admin:create": "tsx --env-file-if-exists=.env src/scripts/admin-create.ts",
    "admin:create:prod": "node --env-file-if-exists=.env dist/admin-create.js",
    "db:seed": "tsx --env-file-if-exists=.env src/db/seed.ts",
    "start:prod": "node --env-file-if-exists=.env dist/index.js",
    "lint": "biome check ."
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "cors": "2.8.6",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "express-rate-limit": "8.7.2",
    "helmet": "8.3.0",
    "jose": "6.2.13",
    "multer": "2.5.0",
    "passkit-generator": "3.7.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "~6.0.3",
    "vitest": "5.1.0"
  }
}
