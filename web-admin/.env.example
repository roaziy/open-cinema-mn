# Open Cinema admin and staff web. Copy to .env and fill in.

# Product name (page titles)
APP_NAME=Open Cinema
# Where the API is, as seen from this server
API_INTERNAL_URL=http://localhost:8080
# Same value as BFF_SECRET in backend/.env (32+ chars in production; empty locally)
BFF_SECRET=
# Optional: local folder with licensed font files (not committed)
ADMIN_FONT_DIR=
# Optional: URL of Apple's official "Add to Apple Wallet" badge (download it from Apple, accept their
# licence, host it e.g. in your storage bucket); empty = plain text button
WALLET_BADGE_URL=
