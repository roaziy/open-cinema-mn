# Product name: admin web title (the API and the app read it too)
APP_NAME=Open Cinema
# API URL used by the admin server (server-side fetch), e.g. https://api.example.com
API_INTERNAL_URL=http://localhost:4000
# Secret shared with the API: the same value as BFF_SECRET in backend/.env (32+ chars, required in
# production; set it in your host's environment settings too). Leave empty for local development.
BFF_SECRET=
# Optional local directory with licensed font files (not committed)
ADMIN_FONT_DIR=
# Admin web: set to 1 once Apple's wallet badge artwork is at web-admin/public/wallet-badge-mn.svg
WALLET_BADGE_FILE=
