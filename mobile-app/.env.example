# Base URL of the Open Cinema API (without /v1). iOS simulator reaches the host via localhost.
# In development a localhost/127.0.0.1 host is swapped for the dev machine's LAN address, so a phone
# on the same Wi-Fi works without editing this. Explicit non-localhost URLs are never changed.
EXPO_PUBLIC_API_URL=http://localhost:4000
# Optional white-label overrides (read by app.config.ts)
# APP_NAME=Open Cinema
# APP_BUNDLE_ID=com.example.opencinema
