# Open Cinema mobile app. Copy to .env and fill in.

# The API (without /v1). In development, localhost is swapped for this machine's LAN address,
# so a phone on the same Wi-Fi works as is.
EXPO_PUBLIC_API_URL=http://localhost:8080

# Optional white-label overrides
# APP_NAME=Open Cinema
# APP_BUNDLE_ID=com.example.opencinema
